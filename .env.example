# Copy to .env for local runs (docker compose reads it automatically).
# For `./mvnw spring-boot:run` against a local Postgres, export these instead.

DB_URL=jdbc:postgresql://localhost:5432/escalade
DB_USER=postgres
DB_PASSWORD=postgres

# Seed a demo org with api_key "esc_demo_key_local" on startup.
ESCALADE_SEED_DEMO=true
