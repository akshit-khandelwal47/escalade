# Copy to .env for local runs (docker compose reads it automatically).
# For `./mvnw spring-boot:run` against a local Postgres, export these instead.

DB_URL=jdbc:postgresql://localhost:5432/escalade
DB_USER=postgres
DB_PASSWORD=postgres

# Seed a demo org with api_key "esc_demo_key_local" on startup.
ESCALADE_SEED_DEMO=true

# --- Notification transports (optional) ---
# Each transport activates only when its credential is set and non-empty. Leave a value blank and
# that channel type falls back to logging the page instead of delivering it. The routing actually
# in effect is logged at startup, e.g.
#   notification routing: EMAIL=EmailNotificationChannel, SLACK=LoggingNotificationChannel, ...

# Slack incoming webhook (https://api.slack.com/messaging/webhooks).
# An escalation step may instead put its own hooks.slack.com URL in the step's `target` to page a
# different channel per step; this value is the default used otherwise.
SLACK_WEBHOOK_URL=

# Email via Resend (https://resend.com). The sending domain must be verified with the provider.
# Send test pages only to an address you actually control — bounces to invented addresses damage
# the sending domain's reputation for every real recipient.
RESEND_API_KEY=
ESCALADE_EMAIL_FROM=Escalade <onboarding@resend.dev>
